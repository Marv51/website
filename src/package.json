{
  "name": "react-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "prebuild": "node scripts/fetch-duolingo.mjs",
    "build": "cross-env NODE_ENV=production react-router build",
    "dev": "react-router dev",
    "start": "cross-env NODE_ENV=production react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "isbot": "^5.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "cross-env": "^10.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
